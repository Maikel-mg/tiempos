{
  "name": "importador-tiempos",
  "version": "1.0.0",
  "description": "Importador de tiempos desde CSV a SQL Server (Web UI)",
  "main": "server.js",
  "scripts": {
    "web": "cd web-ui && npm run dev",
    "start": "node --env-file=.env dist/server.js",
    "dev-backend": "tsx watch --env-file .env server.ts",
    "build:backend": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "tiempos",
    "csv",
    "sql",
    "importador"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mssql": "^10.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
